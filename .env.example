# ==============================================================================
# Skill_pulse ai — AI Career & Skill Navigator (.env.example)
# ==============================================================================
# STAGE 2 NOTE:
# NO ENVIRONMENT VARIABLES ARE REQUIRED TO RUN STAGE 2.
# The application uses local browser persistence (HTML5 LocalStorage) and runs
# out-of-the-box without accounts, authentication, or external cloud keys.
# ==============================================================================

# Optional Next.js Configuration
NEXT_PUBLIC_APP_NAME="Skill_pulse ai"
NEXT_PUBLIC_APP_VERSION="0.2.0"
NEXT_PUBLIC_DEMO_MODE="true"

# Future Extension Placeholders (Stages 2 - 5 & Post-Stage 5 Auth)
# NONE of these are required for local MVP testing:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
