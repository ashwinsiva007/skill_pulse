rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write their own candidate profile and subcollections
    // Master Administrator (admin@gmail.com) has system-wide read access to monitor telemetry
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'admin@gmail.com');

      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'admin@gmail.com');
      }
    }
  }
}

